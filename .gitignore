# IDE
.idea/

# Throwaway probes from a debugging session (screens, tars, commit messages)
.tmp-*

# generated artifacts
__pycache__/
*.pyc
.pytest_cache/
build/
# screenshots/ is a generated artifact; only the shots actually referenced by
# the docs are tracked. Single-screen shots (single/) and unused bottom panels
# (everything except 01/02/05 *_bottom.png) stay local-only.
screenshots/
!screenshots/
screenshots/single/
screenshots/*_bottom.png
!screenshots/0[125]-*_bottom.png
screenshots/en_US/*_bottom.png
!screenshots/en_US/0[125]-*_bottom.png
!screenshots/en_US/*_top.png
*.egg-info/

# scripts/build_release.py output: source-free, byte-compiled bundles.
dist/
screenshots-preview/

# TrimUI package build materials (scripts/package_trimui.py): the vendored
# Pillow and the ffmpeg pair pulled from a device.  Deliberately local-only --
# "make-vendor-archive" is how they travel; the Pillow half is regenerable with
# the pip command in that script's docstring.
vendor/
generated-images/
prototype/android/